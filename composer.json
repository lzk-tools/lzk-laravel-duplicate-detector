{
  "name": "lzk/laravel-duplicate-detector",
  "description": "Configurable, explainable read-only exact and fuzzy duplicate detection for Laravel Eloquent.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "eloquent",
    "duplicates"
  ],
  "require": {
    "php": "^8.2",
    "ext-mbstring": "*",
    "illuminate/database": "^12.0 || ^13.0",
    "illuminate/support": "^12.0 || ^13.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.0",
    "orchestra/testbench": "^10.0 || ^11.0",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^11.5",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "autoload": {
    "psr-4": {
      "Lzk\\DuplicateDetector\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Lzk\\DuplicateDetector\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Lzk\\DuplicateDetector\\DuplicateDetectorServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit",
    "analyse": "@php vendor/bin/phpstan analyse --memory-limit=512M",
    "test:style": "@php vendor/bin/phpcs",
    "check": [
      "@test",
      "@analyse",
      "@test:style"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "archive": {
    "exclude": [
      "/vendor",
      "/composer.lock",
      "/.github",
      "/.tools",
      "/tests",
      "/phpunit.xml",
      "/phpstan.neon.dist",
      "/phpcs.xml.dist",
      "/CONTRIBUTING.md",
      "/.phpunit.cache",
      "/.phpstan.cache",
      "/NUL",
      "/docs/release/0.1.0-candidate.md"
    ]
  }
}
